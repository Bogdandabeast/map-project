#!/bin/sh

ROOT="$(git rev-parse --show-toplevel)"

run_step() {
  echo "$1"
  shift
  "$@" || exit 1
}

run_lint_staged() {
  echo "🔍 Running lint-staged..."
  cd "$ROOT" || exit 1
  bunx lint-staged || exit 1
}

run_frontend_tests() {
  echo "🧪 Running frontend tests..."
  cd "$ROOT/apps/frontend" || exit 1
  bun test || exit 1
  cd "$ROOT" || exit 1
}

run_lint_staged
run_step "🔍 Running backend tests..." bun test "$ROOT/apps/backend/tests"
run_frontend_tests
